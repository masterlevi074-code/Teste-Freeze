local stats = player:FindFirstChild("leaderstats")

-- Se não achar "leaderstats", tenta achar pelos nomes alternativos
if not stats then
    stats = player:FindFirstChild("Stats") or player:FindFirstChild("Status")
end

local fome, sede

if stats then
    fome = stats:FindFirstChild("Fome") or stats:FindFirstChild("Hunger") or stats:FindFirstChild("Food")
    sede = stats:FindFirstChild("Sede") or stats:FindFirstChild("Thirst") or stats:FindFirstChild("Water")
end

-- Se ainda não achou, cria valores fictícios só pro painel não quebrar
if not fome then
    fome = Instance.new("NumberValue")
    fome.Value = 100
    fome.Parent = player
    print("⚠️ 'Fome' não encontrado, usando valor simulado")
end

if not sede then
    sede = Instance.new("NumberValue")
    sede.Value = 100
    sede.Parent = player
    print("⚠️ 'Sede' não encontrado, usando valor simulado")
end

