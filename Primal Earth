-- 5. BOTÕES DE FUNÇÕES (Grid 2x2)
-- ============================================
local function criarBotao(texto, icone, posX, posY, cor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.42, 0, 0, 55)
    btn.Position = UDim2.new(posX, 0, posY, 0)
    btn.BackgroundColor3 = cor
    btn.BackgroundTransparency = 0.15
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.Parent = mainFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn
    
    -- Ícone do botão
    local btnIcon = Instance.new("TextLabel")
    btnIcon.Size = UDim2.new(0, 30, 0, 30)
    btnIcon.Position = UDim2.new(0, 15, 0, 5)
    btnIcon.Text = icone
    btnIcon.TextSize = 24
    btnIcon.BackgroundTransparency = 1
    btnIcon.Parent = btn
    
    -- Texto do botão
    local btnText = Instance.new("TextLabel")
    btnText.Size = UDim2.new(1, -10, 0, 20)
    btnText.Position = UDim2.new(0, 5, 0, 32)
    btnText.Text = texto
    btnText.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnText.BackgroundTransparency = 1
    btnText.Font = Enum.Font.GothamBold
    btnText.TextSize = 12
    btnText.Parent = btn
    
    -- Status ON/OFF (bolinha)
    local statusDot = Instance.new("Frame")
    statusDot.Size = UDim2.new(0, 10, 0, 10)
    statusDot.Position = UDim2.new(1, -20, 0, 5)
    statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    statusDot.BorderSizePixel = 0
    statusDot.Parent = btn
    
    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = statusDot
    
    -- Efeito hover (animação)
    btn.MouseEnter:Connect(function()
        btn.BackgroundTransparency = 0.25
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundTransparency = 0.15
    end)
    
    return btn, statusDot
end

