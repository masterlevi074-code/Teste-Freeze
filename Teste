-- Função para encontrar o jogador alvo
local function getTargetPlayer()
	if targetUsername == "" then
		print("⚠️ Nenhum usuário definido! Digite um nome e clique em OK.")
		return nil
	end
	for _, plr in pairs(Players:GetPlayers()) do
		if plr.Name:lower() == targetUsername:lower() then
			return plr
		end
	end
	print("❌ Jogador não encontrado: " .. targetUsername)
	return nil
end

-- Função para pegar os melhores itens da vítima (exemplo)
-- Adapte os nomes das pastas e propriedades conforme o jogo
local function getBestItemsFromTarget(target)
	local bestItems = {}
	-- Exemplo: procurar itens na pasta "Backpack" ou "Inventory" do alvo
	local inventory = target:FindFirstChild("Inventory") or target:FindFirstChild("Backpack")
	if inventory then
		for _, item in pairs(inventory:GetChildren()) do
			-- Supondo que itens tenham uma propriedade "Value" ou "Rarity"
			local value = item:FindFirstChild("Value") or item:FindFirstChild("Rarity")
			if value then
				table.insert(bestItems, {item = item, value = value.Value})
			end
		end
		-- Ordenar por valor (do maior para o menor)
		table.sort(bestItems, function(a, b) return a.value > b.value end)
		-- Retornar os 5 melhores (ou todos)
		local topItems = {}
		for i = 1, math.min(5, #bestItems) do
			table.insert(topItems, bestItems[i].item)
		end
		return topItems
	end
	return {}
end

-- Função para adicionar itens na trade (simulação)
local function addItemsToTrade(items)
	-- Supondo que haja um botão "Add Item" ou uma função para adicionar
	-- Exemplo: clicar em cada item na interface da trade
	print("🔄 Adicionando " .. #items .. " itens à trade...")
	for _, item in pairs(items) do
		-- Localizar o botão ou frame do item e clicar
		-- Exemplo: item.Parent:FindFirstChild("AddButton") e clicar
		local addBtn = item.Parent and item.Parent:FindFirstChild("AddButton")
		if addBtn and addBtn:IsA("TextButton") then
			addBtn:FireServer() -- ou click()
		else
			print("⚠️ Não foi possível adicionar o item:", item.Name)
		end
		task.wait(0.2)
	end
	print("✅ Itens adicionados!")
end

-- Função para congelar a trade (impedir cancelamento)
local function freezeTrade(enable)
	-- Procurar o botão "Cancelar" na interface da trade e desabilitá-lo
	local cancelBtn = nil
	-- Exemplo: procurar em toda a tela por um botão com texto "Cancelar"
	for _, btn in pairs(gui:GetDescendants()) do
		if btn:IsA("TextButton") and btn.Text:lower() == "cancelar" then
			cancelBtn = btn
			break
		end
	end
	if cancelBtn then
		cancelBtn.Active = not enable  -- se enable = true, desativa o botão
		cancelBtn.Visible = not enable
		print(enable and "🔒 Trade congelada!" or "🔓 Trade descongelada!")
	else
		print("⚠️ Botão 'Cancelar' não encontrado.")
	end
end

-- Função para aceitar automaticamente a trade
local function autoAccept(enable)
	-- Se ativado, fica monitorando a tela até aparecer o botão "Aceitar"
	if enable then
		task.spawn(function()
			while enable do
				local acceptBtn = nil
				for _, btn in pairs(gui:GetDescendants()) do
					if btn:IsA("TextButton") and (btn.Text:lower() == "aceitar" or btn.Text:lower() == "accept") then
						acceptBtn = btn
						break
					end
				end
				if acceptBtn then
					acceptBtn:FireServer() -- ou click()
					print("✅ Trade aceita automaticamente!")
					break
				end
				task.wait(0.5)
			end
		end)
	end
end

